def Xform "whale_doll" (
    apiSchemas = ["IsaacRobotAPI"]
)
{
    string isaac:description
    string isaac:namespace
    rel isaac:physics:robotJoints
    rel isaac:physics:robotLinks = </whale_doll/whale_doll>
    quatd xformOp:orient = (1, 0, 0, 0)
    double3 xformOp:scale = (1, 1, 1)
    double3 xformOp:translate = (0, 0, 0)
    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

    def Xform "whale_doll" (
        apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "IsaacLinkAPI"]
    )
    {
        string isaac:nameOverride (
            displayName = "Name Override"
            doc = "Name override for prim lookup in base name search"
        )
        point3f physics:centerOfMass = (0, 0, 0)
        float3 physics:diagonalInertia = (0.020827468, 0.044171, 0.045094043)
        float physics:mass = 0.8
        quatf physics:principalAxes = (0.8907883, -0.28359002, 0.10732942, -0.3384573)
        quatd xformOp:orient = (0.7066760308408346, 0.7066760308408344, -0.024677670778335405, -0.024677670778335346)
        double3 xformOp:scale = (1, 1, 1)
        double3 xformOp:translate = (0.1446731337075821, -0.0483813325915737, -0.08847068783432084)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

        def Xform "visuals" (
            instanceable = true
            add references = </Flattened_Prototype_1>
        )
        {
        }

        def Xform "collisions" (
            instanceable = true
            add references = </Flattened_Prototype_2>
        )
        {
        }
    }

    def Scope "Looks"
    {
        def Material "material0"
        {
            token outputs:mdl:displacement.connect = </whale_doll/Looks/material0/material0.outputs:out>
            token outputs:mdl:surface.connect = </whale_doll/Looks/material0/material0.outputs:out>
            token outputs:mdl:volume.connect = </whale_doll/Looks/material0/material0.outputs:out>

            def Shader "material0"
            {
                uniform token info:implementationSource = "sourceAsset"
                uniform asset info:mdl:sourceAsset = @gltf/pbr.mdl@
                uniform token info:mdl:sourceAsset:subIdentifier = "gltf_material"
                float inputs:alpha_cutoff = 0 (
                    customData = {
                        float default = 0.5
                        dictionary range = {
                            float max = 1
                            float min = 0
                        }
                    }
                    displayGroup = "Opacity"
                    displayName = "Alpha Cutoff"
                )
                int inputs:alpha_mode = 0 (
                    customData = {
                        int default = 0
                        dictionary range = {
                            int max = 2
                            int min = 0
                        }
                    }
                    displayGroup = "Opacity"
                    displayName = "Alpha Mode"
                    renderType = "gltf_alpha_mode"
                    sdrMetadata = {
                        string __SDR__enum_value = "opaque"
                        string options = "opaque:0|mask:1|blend:2"
                    }
                )
                float inputs:base_alpha = 1 (
                    customData = {
                        float default = 1
                        dictionary range = {
                            float max = 1
                            float min = 0
                        }
                    }
                    displayGroup = "Base Alpha"
                    displayName = "Alpha Mode"
                )
                color3f inputs:base_color_factor = (1, 1, 1) (
                    customData = {
                        float3 default = (1, 1, 1)
                        dictionary range = {
                            float3 max = (1, 1, 1)
                            float3 min = (0, 0, 0)
                        }
                    }
                    displayGroup = "PBR Metallic Roughness"
                    displayName = "Base color"
                )
                token inputs:base_color_texture.connect = </whale_doll/Looks/material0/baseColorTex.outputs:out>
                float inputs:emissive_strength = 10000 (
                    customData = {
                        float default = 1
                    }
                    displayGroup = "Emission"
                    displayName = "Emission Intensity"
                )
                float inputs:metallic_factor = 1 (
                    customData = {
                        float default = 0
                        dictionary range = {
                            float max = 1
                            float min = 0
                        }
                    }
                    displayGroup = "Metallic Roughness"
                    displayName = "Metallic Factor"
                )
                float inputs:roughness_factor = 1 (
                    customData = {
                        float default = 0
                        dictionary range = {
                            float max = 1
                            float min = 0
                        }
                    }
                    displayGroup = "Metallic Roughness"
                    displayName = "Roughness Factor"
                )
                token outputs:out
            }

            def Shader "baseColorTex"
            {
                uniform token info:implementationSource = "sourceAsset"
                uniform asset info:mdl:sourceAsset = @gltf/pbr.mdl@
                uniform token info:mdl:sourceAsset:subIdentifier = "gltf_texture_lookup"
                float2 inputs:offset = (0, 0) (
                    customData = {
                        float2 default = (0, 0)
                    }
                    displayGroup = "Texture Transform"
                    displayName = "Offset"
                )
                float inputs:rotation = 0 (
                    customData = {
                        float default = 0
                    }
                    displayGroup = "Texture Transform"
                    displayName = "Rotation"
                )
                float2 inputs:scale = (1, 1) (
                    customData = {
                        float2 default = (1, 1)
                    }
                    displayGroup = "Texture Transform"
                    displayName = "Scale"
                )
                int inputs:tex_coord_index = 0 (
                    customData = {
                        int default = 0
                    }
                    displayGroup = "Source"
                    displayName = "Coordinate Set"
                )
                asset inputs:texture = @/home/priosin/murphy/demos/RoboVerse/roboverse_pack/whale_doll/configuration/materials/textures/whale_doll_texture0.png@ (
                    displayGroup = "Texture"
                    displayName = "Texture File"
                )
                int inputs:wrap_s = 10497 (
                    customData = {
                        int default = 10497
                    }
                    displayGroup = "Sampler"
                    displayName = "Wrap S"
                    renderType = "gltf_wrapping_mode"
                    sdrMetadata = {
                        string __SDR__enum_value = "repeat"
                        string options = "clamp_to_edge:33071|mirrored_repeat:33648|repeat:10497"
                    }
                )
                int inputs:wrap_t = 10497 (
                    customData = {
                        int default = 10497
                    }
                    displayGroup = "Sampler"
                    displayName = "Wrap T"
                    renderType = "gltf_wrapping_mode"
                    sdrMetadata = {
                        string __SDR__enum_value = "repeat"
                        string options = "clamp_to_edge:33071|mirrored_repeat:33648|repeat:10497"
                    }
                )
                token outputs:out (
                    renderType = "gltf_normal_texture_lookup_value"
                )
            }
        }
    }

    def PhysicsFixedJoint "root_joint" (
        apiSchemas = ["PhysicsArticulationRootAPI", "PhysxArticulationAPI"]
    )
    {
        rel physics:body1 = </whale_doll/whale_doll>
        bool physxArticulation:enabledSelfCollisions = 0
        int physxArticulation:solverPositionIterationCount = 32
        int physxArticulation:solverVelocityIterationCount = 1
    }
}

