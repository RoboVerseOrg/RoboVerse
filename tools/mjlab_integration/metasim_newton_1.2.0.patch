+            ok = valid_world & (addr >= 0) & (k < dim)
+            if not bool(ok.any()):
+                continue
+            fmag = torch.zeros(nacon, device=device)
+            fmag[ok] = efc_force[worldid[ok], addr[ok]]
+            fvec = fvec + fmag.unsqueeze(-1) * frame[:, k, :]
+
+        b1 = geom_bodyid[geom[:, 0]]
+        b2 = geom_bodyid[geom[:, 1]]
+        w = worldid.clamp(min=0)
+        # Scatter-add onto both bodies of each contact (Newton's 3rd-law pair).
+        m = valid_world
+        flat = w * nbody
+        out_flat = out.view(self.num_envs * nbody, 3)
+        out_flat.index_add_(0, (flat + b1)[m], fvec[m])
+        out_flat.index_add_(0, (flat + b2)[m], -fvec[m])
+        return out, names
+
+    def get_subtree_field(self, field: str) -> tuple[torch.Tensor, list[str]]:
+        """Return a batched MuJoCo-Warp ``subtree_*`` field as ``(num_envs, nbody, 3)``.
+
+        Supports ``subtree_angmom`` / ``subtree_linvel`` / ``subtree_com`` —
+        the fields mjlab's BuiltinSensor reads (e.g. ``robot/root_angmom`` →
+        whole-body angular momentum about the trunk subtree COM).
+
+        Returns:
+            vals: ``(num_envs, nbody, 3)`` field value per body.
+            names: leaf body names matching the columns of ``vals``.
+        """
+        names = self._mjw_body_names()
+        device = self.device
+        if self._solver is None or not names:
+            return torch.zeros((self.num_envs, len(names), 3), device=device), names
+        mjw = getattr(self._solver, "mjw_data", None)
+        if mjw is None:
+            return torch.zeros((self.num_envs, len(names), 3), device=device), names
+        arr = getattr(mjw, field, None)
+        if arr is None:
+            return torch.zeros((self.num_envs, len(names), 3), device=device), names
+        vals = wp.to_torch(arr).float().to(device)  # (num_envs, nbody, 3)
+        return vals, names
+
     def close(self) -> None:
         """Clean up Newton resources."""
         log.info("Closing Newton handler")
